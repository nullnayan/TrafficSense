# @file: .env.example
# @exports: TrafficSense environment settings
# @depends_on: backend/core/config.py
# @purpose: Credential placeholders and explicit provider activation controls.
POSTGRES_DB=trafficsense
POSTGRES_USER=trafficsense
POSTGRES_PASSWORD=trafficsense_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trafficsense:trafficsense_dev@localhost:5432/trafficsense
REDIS_URL=redis://localhost:6379/0
OSRM_BASE_URL=https://router.project-osrm.org
# Scout stays offline unless enabled; fixture mode always uses labeled fallback.
OSRM_ENABLED=false
OSRM_TIMEOUT_SECONDS=3
OSRM_MAX_RETRIES=1
SCOUT_TOPOLOGY_CACHE_TTL_SECONDS=300
SCOUT_FALLBACK_SPEED_KMH=40
ASSISTANT_CLOUD_SLOTS_ENABLED=false
ASSISTANT_TIMEOUT_SECONDS=5
# Keyless, deterministic demo by default; optional inference modes are in README.md.
INFERENCE_MODE=calibrated_teacher
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=
# Optional local training weights; defaults to <project>/models/setfit_gatekeeper.
# SETFIT_MODEL_PATH=models/setfit_gatekeeper
NLP_BATCH_SIZE=50
NLP_MAX_BATCHES=10
NLP_MAX_ATTEMPTS=3
LLM_API_KEY=
FINETUNED_LLM_MODEL_ID=
TOMTOM_API_KEY=
HERE_API_KEY=
DBSCAN_EPS_METERS=500
DBSCAN_WINDOW_MINUTES=60
MACRO_SENTRY_POLL_HOURS=2
NOMINATIM_USER_AGENT=TrafficSense-GEU-MP2026CSE126
SSE_HEARTBEAT_SECONDS=15
INGESTION_ENABLED=false
INGESTION_SOURCE_MODE=fixtures
INGESTION_MAX_LOOKBACK_HOURS=48
INGESTION_CATCHUP_THRESHOLD_HOURS=2
INGESTION_WEATHER_ENABLED=false
# JSON array of permitted civic/police JSON or RSS mirror URLs.
ADVISORY_FEED_URLS=[]
NOMINATIM_ENABLED=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_MIN_CONFIDENCE=0.65
SPATIAL_BATCH_SIZE=50
SPATIAL_MAX_BATCHES=10
SPATIAL_MAX_ATTEMPTS=3

# Optional live choke speed samples; fixture modes always stay local.
SCOUT_LIVE_TRAFFIC_ENABLED=false

# Omnichannel adapters activate independently when their key is nonblank.
GEOAPIFY_API_KEY=
ORS_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
YOUTUBE_API_KEY=
NEWSDATA_API_KEY=
CURRENTS_API_KEY=
GNEWS_API_KEY=
DATA_GOV_IN_API_KEY=
# Resource IDs are dataset-specific; never guess a government dataset.
DATA_GOV_RESOURCE_IDS=[]
DIRECT_SCRAPERS_ENABLED=false
TELEGRAM_CHANNELS=["abpganga","News18India"]
# Optional authenticated X search requires current operation ID and your bearer/cookie credentials.
X_AUTH_TOKEN=
X_CT0=
X_BEARER_TOKEN=
X_SEARCH_QUERY_ID=
